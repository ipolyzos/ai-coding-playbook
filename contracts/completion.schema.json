{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Completion report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "summary",
    "acceptance",
    "validation",
    "limitations"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "summary": {
      "type": "string",
      "minLength": 1
    },
    "acceptance": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "criterion",
          "status"
        ],
        "additionalProperties": false,
        "properties": {
          "criterion": {
            "type": "string"
          },
          "status": {
            "enum": [
              "met",
              "unmet",
              "unverified"
            ]
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    },
    "validation": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not_run"
      ]
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}
