{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Validation report",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "task_id",
    "checks",
    "overall_status"
  ],
  "properties": {
    "task_id": {
      "type": "string",
      "minLength": 1
    },
    "overall_status": {
      "enum": [
        "passed",
        "failed",
        "blocked",
        "not_run"
      ]
    },
    "checks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name",
          "status"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "enum": [
              "passed",
              "failed",
              "blocked",
              "not_run"
            ]
          },
          "command": {
            "type": "string"
          },
          "evidence": {
            "type": "string"
          }
        }
      }
    }
  }
}
